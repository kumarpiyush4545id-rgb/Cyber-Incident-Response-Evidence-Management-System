# Cyber Incident Response & Evidence Management System (CIREMS)
# Environment Configuration

PROJECT_NAME="Cyber Incident Response & Evidence Management System"
VERSION="1.0.0"
API_V1_STR="/api"

# Security
SECRET_KEY="cirems-super-secure-production-ready-jwt-secret-key-2026-defense-grade"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL default, auto-fallback to SQLite for easy local dev)
# For local PostgreSQL: postgresql://<user>:<password>@localhost:5432/cirems_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cirems_db
SQLITE_FALLBACK=True

# Storage
UPLOAD_DIR="./uploads"
REPORT_DIR="./reports"
MAX_UPLOAD_SIZE_MB=50

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
